Research.DominationCounterexample.canonical_not_unimodal :
  ¬Research.DominationValley.Unimodal Research.DominationCanonicalPartition.coefficient
Research.DominationCounterexample.canonical_connected_counterexample :
  Research.DominationGadgetGraph.finalGraph.Connected ∧
    Fintype.card Research.DominationGadgetGraph.Vertex = 15211807199220036387538871517957 ∧
      ¬Research.DominationValley.Unimodal Research.DominationCanonicalPartition.coefficient
'Research.DominationCounterexample.canonical_not_unimodal' depends on axioms: [propext, Classical.choice, Quot.sound]
'Research.DominationCounterexample.canonical_connected_counterexample' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
